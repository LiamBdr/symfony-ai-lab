{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}

	# Honor X-Forwarded-* headers from Docker private networks (Traefik in prod)
	servers {
		trusted_proxies static private_ranges
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
		# Redact the authorization query parameter that can be set by Mercure
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
		}
	}

	root /app/public
	# Compressed SSE streams cost memory per connection and enable BREACH-style attacks
	@compressible {
		not path /.well-known/mercure*
		not vars {http.request.orig_uri.path} /chat/stream
	}
	encode @compressible zstd br gzip

	vulcain

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Health endpoint for container / reverse proxy liveness probes
	@healthz path /healthz
	respond @healthz "ok" 200

	@phpRoute {
		not path /.well-known/mercure*
		not path /healthz
		not file {path}
	}
	rewrite @phpRoute index.php

	@frontController path index.php
	php @frontController {
		{$FRANKENPHP_SITE_CONFIG}

		worker {
			file ./public/index.php
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}

	file_server {
		hide *.php
	}
}
